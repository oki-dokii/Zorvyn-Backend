# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/finance_dashboard?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here_minimum_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_minimum_32_chars

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ────────────────────────────────────────────────────────────────────
# Number of bcrypt salt rounds (10-14 recommended for production)
BCRYPT_SALT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
